{
  "name": "careai-functions",
  "private": true,
  "type": "module",
  "description": "CareAI symptom analysis API for Render.",
  "main": "lib/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "build": "tsc",
    "start": "node --env-file-if-exists=.env lib/render-server.js",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "test:rules": "firebase --config ../firebase.json emulators:exec --only firestore,storage \"node --import tsx --test test/rules/*.test.ts\"",
    "emulators": "firebase --config ../firebase.json emulators:start --only auth,firestore,functions,storage",
    "deploy:dev": "firebase --config ../firebase.json deploy --only functions,firestore:rules,firestore:indexes,storage --project dev",
    "deploy:prod": "firebase --config ../firebase.json deploy --only functions,firestore:rules,firestore:indexes,storage --project prod"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "firebase-admin": "^13.4.0",
    "firebase-functions": "^6.4.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^4.0.1",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.3",
    "@types/node": "^22.16.5",
    "firebase-tools": "^14.11.0",
    "firebase": "^11.10.0",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3"
  }
}
