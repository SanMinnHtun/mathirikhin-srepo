VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_USE_FIREBASE_EMULATORS=true

# Enables the browser to call the protected same-origin AI route.
# The OpenRouter key itself must stay server-only and must not use a VITE_ prefix.
VITE_CAREAI_AI_ANALYSIS_ENABLED=false
# Set these only in ignored frontend/.env.local or your server's secret settings.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
# Optional server-only reasoning budget for models such as Gemini 2.5.
# Use -1 for dynamic thinking, 0 to disable thinking, or 1..24576 for a fixed token budget.
OPENROUTER_REASONING_MAX_TOKENS=1024
OPENROUTER_SITE_URL=https://care-ai-six.vercel.app
OPENROUTER_APP_NAME=CareAI
