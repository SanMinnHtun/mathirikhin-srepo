VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_USE_FIREBASE_EMULATORS=true

# Enables the optional vitals AI route. This is a public feature flag, not a secret.
VITE_CAREAI_AI_ANALYSIS_ENABLED=false
# Public URL of the Node symptom API. Use http://localhost:10000 for local split-service development.
VITE_CAREAI_API_BASE_URL=http://localhost:10000
# Set these only in ignored frontend/.env.local or your server's secret settings.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
# Optional server-only reasoning budget for models such as Gemini 2.5.
# Use -1 for dynamic thinking, 0 to disable thinking, or 1..24576 for a fixed token budget.
OPENROUTER_REASONING_MAX_TOKENS=1024
OPENROUTER_SITE_URL=https://care-ai-six.vercel.app
OPENROUTER_APP_NAME=CareAI
